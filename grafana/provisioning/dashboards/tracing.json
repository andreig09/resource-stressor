{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "title": "Infrastructure Dashboard",
      "tooltip": "View container and host resource usage for the same time window",
      "type": "link",
      "url": "/d/infra-overview",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "GET /api/status",
          "value": "GET /api/status"
        },
        "description": "Span name to exclude. Used as a regex in metric panels and an exact match in the trace table. Clear to show all routes.",
        "hide": 0,
        "label": "Exclude Route",
        "name": "exclude_route",
        "options": [
          {
            "selected": true,
            "text": "GET /api/status",
            "value": "GET /api/status"
          }
        ],
        "query": "GET /api/status",
        "type": "textbox"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Request Metrics — Tempo span-metrics → Prometheus (route excluded by variable above)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"observability-stressor\",span_name!~\"$exclude_route\"}[1m])) by (span_name)",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by URL",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(traces_spanmetrics_latency_bucket{service=\"observability-stressor\",span_name!~\"$exclude_route\"}[5m])) by (le, span_name)) * 1000",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "title": "p90 Latency by URL (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"observability-stressor\",status_code=\"STATUS_CODE_ERROR\",span_name!~\"$exclude_route\"}[1m])) by (span_name)",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "title": "Errors by URL",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "title": "Real-Time Spans — use funnel icon on column headers to filter; click a Trace ID to open in Explore",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceName" },
            "properties": [
              { "id": "custom.filterable", "value": true },
              { "id": "displayName", "value": "URL / Span Name" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "duration" },
            "properties": [
              { "id": "custom.filterable", "value": true },
              { "id": "unit", "value": "ms" },
              { "id": "displayName", "value": "Duration (ms)" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "statusCode" },
            "properties": [
              { "id": "custom.filterable", "value": true },
              { "id": "displayName", "value": "Status" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "startTime" },
            "properties": [
              { "id": "custom.width", "value": 200 },
              { "id": "displayName", "value": "Start Time" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rootServiceName" },
            "properties": [
              { "id": "custom.filterable", "value": true }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "frameType": "TraceSearchResult",
        "columnFilters": []
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "filters": [],
          "limit": 40,
          "queryType": "traceql",
          "query": "{ resource.service.name = \"observability-stressor\" && name != \"$exclude_route\" }",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Recent Traces (excluding \"$exclude_route\")",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 12,
      "title": "Infrastructure Correlation — container resource usage in the same time window as the traces above",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\",name!=\"\"}[$__rate_interval])) by (name) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU %",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "container_memory_working_set_bytes{image!=\"\",name!=\"\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Container Memory",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["tracing", "tempo", "otel"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Distributed Tracing",
  "uid": "tracing-overview",
  "version": 1
}
